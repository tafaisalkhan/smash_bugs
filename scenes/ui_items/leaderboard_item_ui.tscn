[gd_scene load_steps=8 format=3]

[ext_resource type="FontVariation" path="res://resources/ui_bold_font.tres" id="bold_font"]

[ext_resource type="Script" path="res://scripts/ui_items/leaderboard_item.gd" id="script"]
[ext_resource type="StyleBox" path="res://resources/ui_white_card.tres" id="card"]
[ext_resource type="StyleBox" path="res://resources/ui_clear_panel.tres" id="clear"]
[ext_resource type="StyleBox" path="res://resources/ui_red_button.tres" id="button"]
[ext_resource type="StyleBox" path="res://resources/ui_mission_ready.tres" id="first_card"]
[ext_resource type="StyleBox" path="res://resources/ui_rank_user.tres" id="user_card"]

[node name="LeaderboardItem" type="Control"]
custom_minimum_size = Vector2(420, 90)
script = ExtResource("script")
first_style = ExtResource("first_card")
normal_style = ExtResource("card")
user_style = ExtResource("user_card")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = ExtResource("card")

[node name="Layout" type="HBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="RankLabel" type="Label" parent="Panel/Layout"]
theme_override_fonts/font = ExtResource("bold_font")
unique_name_in_owner = true
custom_minimum_size = Vector2(42, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "1"

[node name="NameLabel" type="Label" parent="Panel/Layout"]
theme_override_fonts/font = ExtResource("bold_font")
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "Player"

[node name="ScoreLabel" type="Label" parent="Panel/Layout"]
theme_override_fonts/font = ExtResource("bold_font")
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "100"

[node name="RewardLabel" type="Label" parent="Panel/Layout"]
theme_override_fonts/font = ExtResource("bold_font")
unique_name_in_owner = true
custom_minimum_size = Vector2(58, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.54, 0.37, 0.08, 1)
theme_override_font_sizes/font_size = 18
text = "● 10K"
horizontal_alignment = 2

