static func is_supported(glyph: String) -> bool:
	if glyph.is_empty() or glyph.length() > 4:
		return false
	for i in range(glyph.length()):
		if not STROKES.has(glyph.substr(i, 1)):
			return false
	return true

static func build(glyph: String, shift_x: float = 0.0) -> PackedVector2Array:
	var points := PackedVector2Array()
	if not is_supported(glyph):
		return points
	var count := glyph.length()
	var width := minf(100.0, (380.0 - 12.0 * (count - 1)) / count)
	var gap := 12.0
	var total := width * count + gap * (count - 1)
	var left := (500.0 - total) * 0.5 + shift_x
	for i in range(count):
		var character := glyph.substr(i, 1)
		var lowercase := character != character.to_upper()
		var top := 60.0 if lowercase else 30.0
		var height := 105.0 if lowercase else 145.0
		var stroke: String = STROKES[character]
		for token in stroke.split(" "):
			var xy: PackedStringArray = token.split(",")
			points.append(Vector2(left + i * (width + gap) + float(xy[0]) * width, top + float(xy[1]) * height))
	# A connected underline keeps the selected glyph a single falling body.
	points.append(Vector2(left + total, 215.0))
	points.append(Vector2(left, 215.0))
	points.append(Vector2(left + total * 0.5, 215.0))
	points.append(Vector2(left + total * 0.5, 245.0))
	return points
